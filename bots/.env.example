# CreativeLAB bots — copy to bots/.env and fill in. Never commit the real .env.
# Empty values fall back to the defaults shown in comments.

# ─── Telegram ────────────────────────────────────────────────────────────────
# REQUIRED. Bot token from @BotFather. Also used by the WhatsApp bot to post
# leads into the staff chat.
TELEGRAM_BOT_TOKEN=
# REQUIRED for lead delivery. Chat id of the staff chat/group that receives
# every new lead from BOTH bots (e.g. -1001234567890). If unset, users are told
# honestly that delivery failed and are given the direct contacts below.
TELEGRAM_STAFF_CHAT_ID=
# polling (default, for local dev) | webhook (production)
TELEGRAM_MODE=polling
# REQUIRED when TELEGRAM_MODE=webhook. 16–256 chars of A-Z a-z 0-9 _ -.
# Sent by Telegram in X-Telegram-Bot-Api-Secret-Token; requests without it get 401.
# Generate e.g. with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Optional. Public HTTPS URL of the webhook (e.g. https://bots.example.com/telegram/webhook).
# If set, the bot registers it with Telegram on startup (setWebhook).
TELEGRAM_WEBHOOK_URL=
# Optional. Path the webhook server listens on. Default: /telegram/webhook
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# Optional. Port of the Telegram webhook server. Default: 3000
TELEGRAM_PORT=3000

# ─── WhatsApp Cloud API ─────────────────────────────────────────────────────
# REQUIRED for the WhatsApp bot. Permanent (system-user) access token.
WHATSAPP_ACCESS_TOKEN=
# REQUIRED. Phone number id from Meta → WhatsApp → API setup.
WHATSAPP_PHONE_NUMBER_ID=
# REQUIRED. Any string you choose; enter the same value as "Verify token"
# when configuring the webhook in the Meta app dashboard.
WHATSAPP_VERIFY_TOKEN=
# REQUIRED. Meta app secret (App settings → Basic). Used to verify
# X-Hub-Signature-256 on every POST; unsigned/invalid requests get 401.
WHATSAPP_APP_SECRET=
# Optional. Port of the WhatsApp webhook server. Default: 3001
PORT=3001

# ─── Links, photos, contact fallbacks ───────────────────────────────────────
# Optional. Website base used for "see examples" / handoff links. Default: https://creativelab.in.th
SITE_URL=https://creativelab.in.th
# Optional. Where example photos live: absolute URL or a path on SITE_URL
# (e.g. /bot → https://creativelab.in.th/bot/welcome.jpg, /bot/<service>.jpg).
# Leave empty to send no photos (a missing photo is skipped, never an error).
BOT_PHOTO_BASE_URL=
# Optional. Direct contacts shown when a request can't be delivered or a file is too big.
# Defaults mirror src/content/site.ts.
CONTACT_EMAIL=karma8chakra@gmail.com
CONTACT_WHATSAPP=+66 80 870 5704

# ─── Sessions & limits ──────────────────────────────────────────────────────
# Optional. file (default; survives restarts) | memory (tests / throwaway runs)
SESSION_STORE=file
# Optional. JSON file for sessions (relative to the bots/ working dir). Default: ./data/sessions.json
SESSION_STORE_PATH=./data/sessions.json
# Optional. Unfinished conversations are kept this many days. Default: 14
SESSION_TTL_DAYS=14
# Optional. Per-user rate limit: max updates per window. Defaults: 20 per 10000 ms
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=10000
