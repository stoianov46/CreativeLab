# Copy to .env.local and fill in as these become available.
# Nothing here is required to run the site locally — see README.md / TO-DO_2026-11-03.md.

# WhatsApp intake number, digits only with country code, e.g. 66812345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Telegram bot handle, without the @, e.g. creativelab_bot
NEXT_PUBLIC_TELEGRAM_BOT=

# --- Server-only (never prefix with NEXT_PUBLIC_) — see SECURITY.md ---
# Contact form delivery (src/app/api/contact/route.ts). Same bot + staff
# chat as bots/ (TELEGRAM_BOT_TOKEN / TELEGRAM_STAFF_CHAT_ID there).
# Telegram: the owner adds the real token and chat ID after hosting. The
# phone number is NOT a token or chat ID. (TELEGRAM_STAFF_CHAT_ID is the
# older name and still works.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email delivery (Resend HTTP API). Needs both RESEND_API_KEY and a verified
# CONTACT_EMAIL_FROM, e.g. "CreativeLAB <leads@creativelab.in.th>".
# CONTACT_EMAIL_TO defaults to the business email in src/content/site.ts.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=

# Optional CRM / automation: every lead is POSTed here as JSON.
LEAD_WEBHOOK_URL=

# --- Analytics (public IDs; all optional) — src/lib/analytics.ts ---
# Nothing loads and no consent banner shows until at least one is set;
# then scripts load only after the visitor accepts (PDPA/GDPR).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Search engine ownership (public codes; optional) — src/app/[locale]/layout.tsx ---
# The content="…" value from the verification <meta> tag Google Search Console /
# Yandex Webmaster gives you ("HTML tag" method). Emitted on every page once set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
